# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_HAVE_CHARGE_TEMP=y

# MediaTek MT7921U USB Wi-Fi
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76_CONNAC_LIB=m
CONFIG_MT7921_COMMON=m
CONFIG_MT7921U=m
